// Siraat tul Jannah — database schema
//
// Conventions:
// - Models are PascalCase singular (User); tables are snake_case plural (users) via @@map.
// - Fields are camelCase in code (passwordHash); columns are snake_case (password_hash) via @map.
// - Every primary key is a UUID generated by the database.
// - Money is stored as whole Pakistani Rupees in an Int (no floats for money, ever).
//
// Business rules that live OUTSIDE this file:
// - A student may hold only ONE pending/approved enrollment per course at a time.
//   Enforced in the service layer AND by a partial unique index added by hand in
//   prisma/migrations/*_init/migration.sql (Prisma can't express partial indexes).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum EnrollmentStatus {
  PENDING // student applied, waiting for payment verification / admin approval
  APPROVED // admin approved and (usually) assigned a class group
  REJECTED // admin rejected — student may apply again
  COMPLETED // course finished — student may re-enroll in a future batch
  CANCELLED // withdrawn by student or admin
}

enum PaymentMethod {
  EASYPAISA
  JAZZCASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ClassSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeedbackType {
  TEXT
  VOICE
}

// ───────────────────────── Users & roles ─────────────────────────────
// Inherited structure: every person has one `users` row (login details),
// plus exactly one row in students / teachers / admins (role details).

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student       Student?
  teacher       Teacher?
  admin         Admin?
  refreshTokens RefreshToken[]

  @@map("users")
}

// Long-lived login sessions. The app swaps a refresh token for a new short-lived
// access token without asking for the password again. Only a SHA-256 hash is
// stored, so a leaked database can't be used to log in. Revoking = logout.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Student {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  whatsappNumber String?   @map("whatsapp_number")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  guardianName   String?   @map("guardian_name")
  guardianPhone  String?   @map("guardian_phone")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendance  Attendance[]
  feedback    Feedback[]

  @@map("students")
}

model Teacher {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  fullName       String   @map("full_name")
  whatsappNumber String?  @map("whatsapp_number")
  bio            String?
  qualifications String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroups      ClassGroup[]
  attendanceMarked Attendance[]
  feedbackGiven    Feedback[]
  lectures         RecordedLecture[]

  @@map("teachers")
}

model Admin {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  fullName       String   @map("full_name")
  whatsappNumber String?  @map("whatsapp_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedEnrollments Enrollment[]
  reviewedPayments    Payment[]
  issuedCertificates  Certificate[]
  paymentAccounts     PaymentAccount[]

  @@map("admins")
}

// ─────────────────────── Courses & class groups ──────────────────────

model Course {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  slug          String   @unique // URL-friendly name, e.g. "tajweed-basics"
  description   String
  level         String? // e.g. "Beginner"
  durationWeeks Int?     @map("duration_weeks")
  feePkr        Int      @map("fee_pkr")
  thumbnailUrl  String?  @map("thumbnail_url")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  classGroups ClassGroup[]
  enrollments Enrollment[]
  lectures    RecordedLecture[]

  @@map("courses")
}

// A class group is one teacher teaching one batch of a course on a schedule,
// e.g. "Tajweed Basics — Batch 3 — Evening". A new batch = new class group(s).
model ClassGroup {
  id                String    @id @default(uuid()) @db.Uuid
  courseId          String    @map("course_id") @db.Uuid
  teacherId         String?   @map("teacher_id") @db.Uuid
  name              String
  batchLabel        String?   @map("batch_label") // e.g. "Batch 3 — Jan 2027"
  scheduleText      String?   @map("schedule_text") // e.g. "Mon/Wed/Fri 8–9pm PKT"
  startDate         DateTime? @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  maxStudents       Int?      @map("max_students")
  zoomMeetingId     String?   @map("zoom_meeting_id")
  zoomPasscode      String?   @map("zoom_passcode")
  whatsappGroupLink String?   @map("whatsapp_group_link") // low-bandwidth fallback
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher     Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  sessions    ClassSession[]
  lectures    RecordedLecture[]

  @@index([courseId])
  @@index([teacherId])
  @@map("class_groups")
}

// ─────────────────────── Enrollments & payments ──────────────────────
// Own UUID primary key (NOT student_id): one student → many enrollments,
// across different courses and across repeat batches of the same course.

model Enrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  classGroupId    String?          @map("class_group_id") @db.Uuid // set by admin on approval
  status          EnrollmentStatus @default(PENDING)
  approvedById    String?          @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?        @map("approved_at")
  completedAt     DateTime?        @map("completed_at")
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classGroup  ClassGroup?  @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  approvedBy  Admin?       @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  payments    Payment[]
  certificate Certificate?
  feedback    Feedback[]

  @@index([studentId, courseId])
  @@index([classGroupId])
  @@index([status])
  @@map("enrollments")
}

// A student uploads a screenshot of their Easypaisa/JazzCash transfer;
// an admin verifies it. Many payments per enrollment (monthly fees, re-uploads).
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  enrollmentId  String        @map("enrollment_id") @db.Uuid
  method        PaymentMethod
  amountPkr     Int           @map("amount_pkr")
  transactionId String?       @map("transaction_id") // TID printed on the receipt
  proofImageUrl String        @map("proof_image_url")
  status        PaymentStatus @default(PENDING)
  reviewedById  String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewNote    String?       @map("review_note")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviewedBy Admin?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@index([status])
  @@map("payments")
}

// The academy's receiving accounts, shown on the payment screen.
// Admins edit these from the dashboard so numbers never need a code change.
model PaymentAccount {
  id            String        @id @default(uuid()) @db.Uuid
  method        PaymentMethod
  accountTitle  String        @map("account_title") // name on the account
  accountNumber String        @map("account_number") // phone number or IBAN
  instructions  String?
  isActive      Boolean       @default(true) @map("is_active")
  updatedById   String?       @map("updated_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  updatedBy Admin? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("payment_accounts")
}

// ─────────────────────── Live classes & attendance ───────────────────

model ClassSession {
  id              String             @id @default(uuid()) @db.Uuid
  classGroupId    String             @map("class_group_id") @db.Uuid
  topic           String?
  scheduledAt     DateTime           @map("scheduled_at")
  durationMinutes Int                @default(60) @map("duration_minutes")
  status          ClassSessionStatus @default(SCHEDULED)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  classGroup ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([classGroupId, scheduledAt])
  @@map("class_sessions")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  classSessionId String           @map("class_session_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  status         AttendanceStatus
  markedById     String?          @map("marked_by_id") @db.Uuid
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy     Teacher?     @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([classSessionId, studentId]) // one mark per student per class
  @@index([studentId])
  @@map("attendance")
}

// ─────────────────────── Feedback, certificates, lectures ────────────

model Feedback {
  id                   String       @id @default(uuid()) @db.Uuid
  studentId            String       @map("student_id") @db.Uuid
  teacherId            String       @map("teacher_id") @db.Uuid
  enrollmentId         String?      @map("enrollment_id") @db.Uuid
  type                 FeedbackType
  textContent          String?      @map("text_content") // when type = TEXT
  voiceUrl             String?      @map("voice_url") // when type = VOICE
  voiceDurationSeconds Int?         @map("voice_duration_seconds")
  readAt               DateTime?    @map("read_at")
  createdAt            DateTime     @default(now()) @map("created_at")

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@map("feedback")
}

model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  enrollmentId      String   @unique @map("enrollment_id") @db.Uuid // one per completed enrollment
  certificateNumber String   @unique @map("certificate_number") // e.g. "STJ-2027-00042"
  issuedAt          DateTime @default(now()) @map("issued_at")
  issuedById        String?  @map("issued_by_id") @db.Uuid
  pdfUrl            String?  @map("pdf_url")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  issuedBy   Admin?     @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("certificates")
}

model RecordedLecture {
  id              String    @id @default(uuid()) @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  classGroupId    String?   @map("class_group_id") @db.Uuid // null = visible to the whole course
  uploadedById    String?   @map("uploaded_by_id") @db.Uuid
  title           String
  description     String?
  videoUrl        String    @map("video_url")
  durationSeconds Int?      @map("duration_seconds")
  sortOrder       Int       @default(0) @map("sort_order")
  publishedAt     DateTime? @map("published_at") // null = draft
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  uploadedBy Teacher?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([courseId, sortOrder])
  @@map("recorded_lectures")
}
