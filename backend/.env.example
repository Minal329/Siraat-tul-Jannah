# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/siraat_dev?schema=public"
PORT=4000
# Comma-separated list of websites allowed to call the API from a browser.
# Add http://localhost:8081 to try the mobile app in a browser (npx expo start --web).
CORS_ORIGINS="http://localhost:5173"
# Secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
# Folder for uploaded files, relative to backend/. Keep it private and backed up.
UPLOAD_DIR="uploads"
# How many proxies sit in front of the API (Caddy in production = 1, nothing locally = 0).
TRUST_PROXY=0
# Website address printed on certificates for verification.
PUBLIC_WEB_URL="http://localhost:5173"
# Optional — create Zoom meetings from the admin dashboard. From a Zoom
# "Server-to-Server OAuth" app (Zoom Marketplace → Develop → Build app), with the
# meeting:write:meeting:admin scope. Leave empty to paste meeting IDs by hand.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
