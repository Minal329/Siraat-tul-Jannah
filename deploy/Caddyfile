# Caddy: the front door of the live server.
# - Gets and renews the HTTPS certificate for DOMAIN automatically (Let's Encrypt).
# - /api/* goes to the API container. There is no website: everyone uses the mobile app.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		respond "Siraat tul Jannah — please use the mobile app." 404
	}
}
