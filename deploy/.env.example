# Settings for the live server. Copy to deploy/.env (never commit it) and fill in.

# The website's domain, pointed at this server's IP address (an "A record").
DOMAIN=siraattuljannah.com

# Database password — letters and numbers only. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Signs login tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Optional — create Zoom meetings from the admin dashboard (see docs/deployment.md).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
